# Copy to .env for LOCAL development only. Never commit .env.
# On Render, set these in the service's Environment tab instead.

# --- Cloudflare R2 (required) ---
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=your-private-bucket-name
# Optional. Leave empty to keep the bucket private and serve presigned URLs.
# Only set this if you deliberately attached a public custom domain to the bucket.
R2_PUBLIC_BASE_URL=

# --- Flask ---
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=replace-with-a-long-random-string
FLASK_DEBUG=0

# --- Behaviour (optional; defaults shown) ---
MAX_UPLOAD_BYTES=20971520
RETENTION_DAYS=30
DOWNLOAD_URL_TTL=300
UPLOAD_RATE_LIMIT=10 per minute;100 per day
# Use a shared store (e.g. redis://...) when running more than one instance.
RATELIMIT_STORAGE_URI=memory://

# --- Admin file listing ---
# Set a password to enable the /admin page (list every upload, delete any file).
# Leave blank to disable the admin area entirely.
ADMIN_PASSWORD=
# How many files the admin page lists at most.
ADMIN_LIST_LIMIT=2000
# Set to 1 in production (HTTPS) so the admin session cookie is marked Secure.
# Leave 0 for local http development, or the login cookie won't be stored.
SESSION_COOKIE_SECURE=0

# --- Legal pages (shown highlighted until set) ---
SITE_NAME=Fileshelf
OPERATOR_NAME=
CONTACT_EMAIL=
LEGAL_LAST_UPDATED=
